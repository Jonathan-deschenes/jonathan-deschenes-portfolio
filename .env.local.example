# URL canonique de production (sans slash final)
NEXT_PUBLIC_SITE_URL=https://jodeschenes.com

# Calendrier Cal.com — URL d'embed du type de rencontre 30 min
NEXT_PUBLIC_BOOKING_URL=https://cal.com/jodeschenes/rencontre-30min

# Resend — clé API pour l'envoi des courriels de confirmation
RESEND_API_KEY=

# Expéditeur (doit être un domaine vérifié dans Resend)
RESEND_FROM="Jonathan Deschênes <info@jodeschenes.com>"

# Adresse interne qui reçoit les notifications de soumission/contact
NOTIFY_EMAIL=info@jodeschenes.com
